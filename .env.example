# Required production origin. Use the same canonical HTTPS origin for both.
NEXT_PUBLIC_SITE_URL=https://gtbsbooks.com
BETTER_AUTH_URL=https://gtbsbooks.com

# Better Auth signing/encryption secret (minimum 32 random characters).
# Generate once, store only in Vercel, and keep stable across deployments.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional token from Google Search Console.
GOOGLE_SITE_VERIFICATION=

# Server-only Resend send-only API key. The verified sender is fixed in code as
# GTBS Support <support@gtbsbooks.com>.
RESEND_API_KEY=
# Optional destination for Contact submissions; defaults to support@gtbsbooks.com.
CONTACT_RECIPIENT_EMAIL=support@gtbsbooks.com

# Server-only PostgreSQL connection used by migrations, seeding, Better Auth,
# email throttling, and content. On Vercel use the Supabase transaction pooler
# URL with TLS, not a browser key or a direct per-function connection.
DATABASE_URL=postgresql://user:password@host:6543/database?sslmode=require&uselibpqcompat=true
# Keep this low for serverless instances. Defaults to 2 in production.
DATABASE_POOL_MAX=2

# Optional local/deployed origin targeted by `pnpm test:api`; defaults to localhost:3000.
API_SMOKE_BASE_URL=http://localhost:3000

# Server-only UploadThing token used by authenticated admin image uploads.
UPLOADTHING_TOKEN=

# The only identity allowed to use the Admin application. Create it once in
# PostgreSQL with `pnpm admin:setup`; passwords are never environment values.
ADMIN_EMAIL=admin@example.com
