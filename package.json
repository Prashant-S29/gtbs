{
  "name": "e-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbopack": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "db:migrate": "node scripts/setup-db.mjs",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "admin:setup": "pnpm db:migrate && tsx scripts/setup-admin.ts",
    "test:admin-auth": "node --experimental-strip-types --test tests/admin-auth.test.ts",
    "test:content": "node --experimental-strip-types --test tests/content-management.test.ts",
    "test:site": "node --experimental-strip-types --test tests/site-integrity.test.ts",
    "test:api": "tsx scripts/smoke-api.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.3",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "better-auth": "^1.7.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "uploadthing": "^7.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.17.0"
}
